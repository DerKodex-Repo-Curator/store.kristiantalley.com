# Production build env — loaded by `vite build` (NOT `npm run dev`).
# Only VITE_-prefixed (public) values belong here; they get baked into the JS
# bundle. Server-side secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) live in
# the server's EnvironmentFile (/etc/store.kristiantalley.com/env), never here.

# MCP server + checkout: served from THIS box, same origin as the storefront.
# (The llm.kristiantalley.com box only runs Ollama — no MCP backend there.)
VITE_MCP_TOOLS_URL=https://store.kristiantalley.com/mcp
VITE_CHECKOUT_URL=https://store.kristiantalley.com/checkout

# Support bot LLM — stays on the existing llm.kristiantalley.com Ollama box
# (it has qwen36-opus:latest; this box's local Ollama does not).
VITE_OLLAMA_URL=https://llm.kristiantalley.com
VITE_MODEL=qwen36-opus:latest

# Shopify intentionally omitted — catalog serves from local products.json.
