# Shopify Storefront API Configuration
# Copy this file to .env and fill in your values

# Your Shopify store domain (e.g., your-store.myshopify.com)
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token (public, safe for client-side)
# Generate this in Shopify Admin > Apps > Develop apps > Create an app > Configure Storefront API scopes
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Storefront API version (YYYY-MM format)
VITE_SHOPIFY_API_VERSION=2024-10

# Ollama LLM Configuration for Support Bot
VITE_OLLAMA_URL=https://llm.kristiantalley.com
VITE_MODEL=incept5-narrator:latest
