# Shopify Storefront API Configuration
# Copy this file to .env and fill in your values

# Your Shopify store domain (e.g., your-store.myshopify.com)
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token (public, safe for client-side)
# Generate this in Shopify Admin > Apps > Develop apps > Create an app > Configure Storefront API scopes
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Storefront API version (YYYY-MM format)
VITE_SHOPIFY_API_VERSION=2024-10

# Ollama LLM Configuration for Support Bot
VITE_OLLAMA_URL=https://llm.kristiantalley.com
VITE_MODEL=incept5-narrator:latest

# MCP Server (browser → bot/cart). In prod, proxy this via nginx and use a public URL.
VITE_MCP_TOOLS_URL=http://localhost:3001/mcp

# --- Stripe Checkout ---
# Client: endpoint that creates the Stripe Checkout Session (served by the MCP server).
# In prod, proxy via nginx, e.g. https://store.kristiantalley.com/checkout
VITE_CHECKOUT_URL=http://localhost:3001/checkout

# Server-only (no VITE_ prefix → never bundled into the client).
# Get keys at https://dashboard.stripe.com/apikeys — use the test key (sk_test_…) first.
STRIPE_SECRET_KEY=sk_test_xxx
# Buyer is returned here after checkout (your site origin)
SITE_URL=http://localhost:5173
# Webhook signing secret (authoritative payment confirmation).
# Local: `stripe listen --forward-to localhost:3001/webhook` prints a whsec_…
# Prod: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional overrides
# STRIPE_CURRENCY=usd
# STRIPE_SHIPPING_COUNTRIES=US,CA,GB,AU,DE,FR,NL,IE,NZ
