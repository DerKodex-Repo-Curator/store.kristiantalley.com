# ─────────────────────────────────────────────────────────────────────────────
# Production secrets for the store.kristiantalley.com MCP / Stripe checkout server
#
# Installed to:  /etc/store.kristiantalley.com/env   (root-owned, chmod 600)
# Loaded by:     systemd  →  EnvironmentFile=-/etc/store.kristiantalley.com/env
#                These values take PRECEDENCE over any repo-root .env.
#
# ⚠️  NEVER commit real key values. This file in the repo is a TEMPLATE only —
#     the placeholders below get replaced on the server, not here.
# ─────────────────────────────────────────────────────────────────────────────

# --- Stripe (LIVE) ---------------------------------------------------------
# Live secret key — https://dashboard.stripe.com/apikeys with Test mode OFF.
STRIPE_SECRET_KEY=sk_live_REPLACE_ME

# Signing secret for THIS webhook endpoint:
#   Dashboard → Developers → Webhooks → "ktt store"
#   (https://store.kristiantalley.com/webhook, id we_1TfubnJvdDgefBhUjSxox219)
#   → Signing secret → Reveal.   Must be the LIVE endpoint's secret.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Required ---------------------------------------------------------------
# Where Stripe returns the buyer after the hosted checkout page.
# (If unset, the server falls back to http://localhost:5173 — wrong in prod.)
SITE_URL=https://store.kristiantalley.com

# --- Optional (uncomment to override defaults) -----------------------------
# STRIPE_CURRENCY=usd
# STRIPE_SHIPPING_COUNTRIES=US,CA,GB,AU,DE,FR,NL,IE,NZ
