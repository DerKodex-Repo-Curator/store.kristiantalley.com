# Nginx configuration for kristiantalley.com store
# Copy this file to /etc/nginx/sites-available/kristiantalley-store
# Then symlink: ln -s /etc/nginx/sites-available/kristiantalley-store /etc/nginx/sites-enabled/

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name kristiantalley.com www.kristiantalley.com store.kristiantalley.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Main site - kristiantalley.com
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name kristiantalley.com www.kristiantalley.com;

    # SSL certificates - adjust paths for your setup (Let's Encrypt recommended)
    ssl_certificate /etc/letsencrypt/live/kristiantalley.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kristiantalley.com/privkey.pem;

    # SSL configuration
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # HSTS
    add_header Strict-Transport-Security "max-age=63072000" always;

    # Document root - where the built React app lives
    root /var/www/kristiantalley.com/dist;
    index index.html;

    # Logging
    access_log /var/log/nginx/kristiantalley.access.log;
    error_log /var/log/nginx/kristiantalley.error.log;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Static assets with long cache
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback - all routes go to index.html for client-side routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
    }
}

# Store subdomain (if using separate subdomain) - store.kristiantalley.com
# This configuration is identical but can be customized if needed
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name store.kristiantalley.com;

    ssl_certificate /etc/letsencrypt/live/kristiantalley.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kristiantalley.com/privkey.pem;

    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=63072000" always;

    # Same document root as main site (single SPA serves both domains)
    root /var/www/kristiantalley.com/dist;
    index index.html;

    access_log /var/log/nginx/store.kristiantalley.access.log;
    error_log /var/log/nginx/store.kristiantalley.error.log;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ /\. {
        deny all;
    }
}
