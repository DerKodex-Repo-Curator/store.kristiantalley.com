# Production build config — copy to .env.production and fill in your domain.
# `.env.production` is gitignored (keeps infra hostnames out of the repo).
# Only VITE_-prefixed (public) values belong here; server secrets live in the
# backend's EnvironmentFile, never here.

# Where the MCP/checkout backend is reachable (behind nginx)
VITE_MCP_TOOLS_URL=https://YOUR_MCP_DOMAIN/mcp
VITE_CHECKOUT_URL=https://YOUR_MCP_DOMAIN/checkout

# Support-bot LLM (Ollama) endpoint
VITE_OLLAMA_URL=https://YOUR_MCP_DOMAIN
VITE_MODEL=your-model:latest
